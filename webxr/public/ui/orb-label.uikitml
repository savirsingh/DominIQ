<meta preferred-color-scheme="dark" />

<style>
  .callout {
    width: 280;
    flex-direction: column;
    gap: 6;
    padding: 10;
    border-width: 1;
    border-color: white;
    background-color: rgba(0, 0, 0, 0.4);
    font-family: space-mono;
    color: white;
  }

  .name {
    font-size: 16;
    font-weight: bold;
  }

  .rule {
    height: 1;
    background-color: white;
  }

  .description {
    font-size: 12;
    color: #d5dde3;
  }
</style>

<div id="callout" class="callout" anchor-y="bottom">
  <p id="orb-name" class="name">NAME</p>
  <div class="rule"></div>
  <p id="orb-description" class="description">Description</p>
</div>
